
#!/usr/bin/env python3
"""Dependency-free Cyberpunk 2077 build and weapon helper.

Recommendations are organized by playstyle and are intended as a planning aid.
Weapon performance and availability can change between game patches and DLC.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass


