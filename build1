def normalize(value: str) -> str:
    return value.strip().lower()


def score_build(build: Build, preferences: set[str]) -> int:
    return sum(3 if preference in build.tags else 0 for preference in preferences)


def recommend_builds(preferences: set[str], limit: int = 3) -> list[Build]:
    ranked = sorted(BUILDS, key=lambda build: score_build(build, preferences), reverse=True)
    return ranked[:limit]


def find_weapons(category: str | None = None, preferences: set[str] | None = None) -> list[Weapon]:
    category = normalize(category) if category else None
    preferences = preferences or set()
    matches = [
        weapon for weapon in WEAPONS
        if (not category or category in weapon.category.lower())
        and (not preferences or any(tag in weapon.build_tags for tag in preferences))
    ]
    return matches


def print_build(build: Build) -> None:
    print(f"\n{build.name} [{build.difficulty} difficulty]")
    print(f"  {build.description}")
    print(f"  Attributes: {', '.join(build.attributes)}")
    print(f"  Skills: {', '.join(build.skills)}")
    print(f"  Perks: {', '.join(build.perks)}")
    print(f"  Cyberware: {', '.join(build.cyberware)}")
    print(f"  Weapons: {', '.join(build.weapons)}")


def print_weapons(weapons: list[Weapon]) -> None:
    if not weapons:
        print("No matching weapons found. Try a broader category or different tags.")
        return
    print("\nRecommended weapons")
    for weapon in weapons:
        print(f"  {weapon.name} ({weapon.category}) - {weapon.reason}")


def interactive() -> None:
    print("Cyberpunk 2077 Build Helper")
    print("Try tags such as netrunner, stealth, blades, solo, smart, tech, or gunslinger.")
    preferences = {normalize(value) for value in input("Playstyle preferences (comma-separated): ").split(",") if normalize(value)}
    print("\nBuild recommendations")
    for build in recommend_builds(preferences):
        print_build(build)
    print_weapons(find_weapons(preferences=preferences))


def main() -> None:
    parser = argparse.ArgumentParser(description="Recommend Cyberpunk 2077 builds and weapons.")
    parser.add_argument("--preferences", help="Comma-separated tags, such as stealth,blades or solo,smart")
    parser.add_argument("--weapon-category", help="Filter weapons by category, such as pistol, shotgun, or katana")
    parser.add_argument("--all-builds", action="store_true", help="Show every build archetype")
    parser.add_argument("--weapons-only", action="store_true", help="Only show weapon recommendations")
    args = parser.parse_args()

    if not args.preferences and not args.weapon_category and not args.all_builds and not args.weapons_only:
        interactive()
        return

    preferences = {normalize(value) for value in (args.preferences or "").split(",") if normalize(value)}
    if not args.weapons_only:
        print("Build recommendations")
        builds = BUILDS if args.all_builds else recommend_builds(preferences)
        for build in builds:
            print_build(build)
    print_weapons(find_weapons(args.weapon_category, preferences))


if __name__ == "__main__":
    main()
